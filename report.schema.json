{
  "type": "object",
  "properties": {
    "report_version": {
      "type": "string",
      "enum": [
        "2"
      ]
    },
    "system": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "name",
        "environments",
        "exclusions"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "minItems": 1
    },
    "boundaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/boundary"
      },
      "minItems": 1
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      },
      "minItems": 1
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      },
      "minItems": 0
    }
  },
  "required": [
    "report_version",
    "system",
    "nodes",
    "edges",
    "boundaries",
    "scenarios",
    "coverage",
    "evidence",
    "questions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Security Boundary Mapping system report",
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "principal",
            "credential",
            "service",
            "control",
            "resource",
            "action"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "owner_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "details": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "environment",
        "owner_ids",
        "details",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "requires_all": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "enum": [
            "observed",
            "source",
            "unknown"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "relation": {
          "type": "string",
          "enum": [
            "deploy",
            "use_credential",
            "read_secret",
            "administer",
            "recover",
            "replace",
            "upgrade",
            "execute",
            "impersonate",
            "access",
            "other"
          ]
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "requires_all",
        "description",
        "basis",
        "evidence_ids",
        "relation"
      ],
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "enforcer_id": {
          "type": "string",
          "minLength": 1
        },
        "gate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "coverage_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "challenge": {
          "type": "string",
          "enum": [
            "supported",
            "revised",
            "unresolved"
          ]
        },
        "challenge_notes": {
          "type": "string",
          "minLength": 1
        },
        "remaining_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "label",
        "action_id",
        "enforcer_id",
        "gate_ids",
        "coverage_ids",
        "challenge",
        "challenge_notes",
        "remaining_checks",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "initial_control": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "assumptions": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "type": "string",
          "enum": [
            "supported",
            "unresolved"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "initial_control",
        "assumptions",
        "review"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "system_inventory",
            "source",
            "deployment",
            "credentials",
            "administration",
            "recovery",
            "external_provider"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "inspected",
            "partial",
            "unavailable",
            "excluded"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "environment",
        "category",
        "subject",
        "status",
        "notes",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "affects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "needed_evidence": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "answered",
            "resolved"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "question",
        "affects",
        "needed_evidence",
        "answer",
        "status",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "source",
            "deployment",
            "attestation"
          ]
        },
        "captured_at": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "root",
        "path",
        "start_line",
        "end_line",
        "sha256",
        "kind",
        "captured_at",
        "provenance"
      ],
      "additionalProperties": false
    }
  }
}
